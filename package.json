{
  "name": "pex-crawler",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/tomacheese/pex-crawler",
  "bugs": {
    "url": "https://github.com/tomacheese/pex-crawler/issues"
  },
  "license": "MIT",
  "author": "Tomachi <tomachi@tomacheese.com>",
  "private": true,
  "main": "dist/main.js",
  "repository": {
    "url": "git@github.com:tomacheese/pex-crawler.git",
    "type": "git"
  },
  "scripts": {
    "fix:prettier": "prettier --write src",
    "lint:tsc": "tsc",
    "test": "jest --runInBand --passWithNoTests --detectOpenHandles --forceExit",
    "fix": "run-z fix:prettier fix:eslint",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc",
    "start": "tsx ./src/main.ts",
    "dev": "tsx watch ./src/main.ts",
    "fix:eslint": "eslint . -c eslint.config.mjs --fix",
    "lint:eslint": "eslint . -c eslint.config.mjs",
    "lint:prettier": "prettier --check src",
    "generate-schema": "typescript-json-schema --required --esModuleInterop src/config.ts Config -o schema/Configuration.json"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.17.6",
    "@book000/node-utils": "1.26.38",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "cheerio": "1.2.0",
    "eslint": "10.15.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "jest": "30.5.2",
    "jest-expect-message": "1.1.3",
    "prettier": "3.10.1",
    "run-z": "2.1.0",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-json-schema": "0.68.0"
  },
  "jest": {
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "setupFilesAfterEnv": [
      "jest-expect-message"
    ]
  },
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4"
}
